# Server
NODE_ENV=development
PORT=3000

# Database (Mock JSON storage in database/data/ - PostgreSQL not required)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=chatbox_db
# DB_USER=chatbox_user
# DB_PASSWORD=your_strong_password_here

# JWT
JWT_SECRET=your_jwt_secret_minimum_32_chars_here
JWT_EXPIRES_IN=7d

# Admin khởi tạo (dùng khi seed admin lần đầu)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=Administrator

# ==============================================================================
# AI Provider Configuration
# Chọn 1 trong 2 Provider: 'gemini' (Google Cloud AI) hoặc 'ollama' (Local AI)
# ==============================================================================
AI_PROVIDER=ollama
# --- Cấu hình cho Google Gemini ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Cấu hình cho Ollama (Local AI) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# OLLAMA_API_KEY=

# --- Tham số chung cho AI ---
AI_TEMPERATURE=0.7
AI_TIMEOUT=120000
AI_MAX_RETRIES=2

# Timezone
TZ=Asia/Ho_Chi_Minh

# Session
SESSION_SECRET=your_session_secret_here
